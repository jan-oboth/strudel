// ACID FUNK — "NEON STRUT"
// Disco-funk meets acid house, catchy synth riff, Chromeo energy

setCps(118/60/4)

register('acidenv', (x, pat) => pat.lpf(100).lpenv(x * 9).lps(.2).lpd(.12))

// === KICK — Four-on-floor 909, sidechain master ===
$: s("bd*4").bank("RolandTR909")
  .gain(.9).shape(.18)
  .lpf(3000)
  .room(.06).roomsize(1)
  .duck("1:2:3:4:5:6:7").duckattack(.015).duckdepth(.85)
  .orbit(0)
  ._scope({color:"#ff00ff", thickness:2})
  ._spectrum({color:"#ff00ff", thickness:2})

// === KICK ALT — Broken funk pattern ===
_$: s("[bd*2] [bd ~ bd ~] [bd*2] [~ bd bd ~]").bank("RolandTR909")
  .gain(.88).shape(.2)
  .lpf(3000)
  .room(.06).roomsize(1)
  .duck("1:2:3:4:5:6:7").duckattack(.015).duckdepth(.85)
  .orbit(0)
  ._scope({color:"#ff00ff", thickness:2})

// === SNARE — Backbeat with gated reverb ===
$: s("~ sd ~ sd").bank("RolandTR909")
  .gain(.3)
  .room(.4).roomsize(2)
  .hpf(800)
  .orbit(2)

// === SNARE ALT — Ghost notes ===
_$: s("~ sd [~ sd:1?] sd").bank("RolandTR909")
  .gain("~ .3 .12 .3")
  .room(.4).roomsize(2)
  .hpf(800)
  .orbit(2)

// === HATS — 16th-note groove with accents ===
$: s("hh*16").bank("RolandTR909")
  .gain("<0.18 0.07 0.13 0.07>*4")
  .hpf(7000)
  .pan(rand.range(.35,.65))
  .orbit(3)

// === OPEN HAT — Offbeat breath ===
$: s("~ oh ~ oh").bank("RolandTR909")
  .gain(.1)
  .hpf(5500)
  .decay(.1)
  .orbit(3)

// === HATS ALT — Sparse 8ths ===
_$: s("hh*8").bank("RolandTR909")
  .gain("<0.18 0.09>*4")
  .hpf(7000)
  .pan(rand.range(.35,.65))
  .orbit(3)

// === SYNTH RIFF — Catchy funk motif, the star ===
_$: note("<[e4 ~ g4 a4] [~ b4 ~ a4] [g4 e4 ~ d4] [~ ~ e4 ~]>")
  .s("sawtooth")
  .lpf(sine.range(800, 3500).slow(8))
  .lpq(4)
  .gain(.55)
  .decay(.15).sustain(.1).release(.08)
  .room(.15).roomsize(1.5)
  .orbit(1)
  ._pianoroll({color:"#ff00ff"})

// === SYNTH RIFF ALT 1 — Syncopated variation ===
_$: note("<[~ e4 g4 ~] [a4 ~ b4 a4] [~ g4 ~ e4] [d4 ~ ~ e4]>")
  .s("sawtooth")
  .lpf(sine.range(800, 3500).slow(8))
  .lpq(4)
  .gain(.55)
  .decay(.15).sustain(.1).release(.08)
  .room(.15).roomsize(1.5)
  .orbit(1)
  ._pianoroll({color:"#ff00ff"})

// === SYNTH RIFF ALT 2 — Higher register call-response ===
_$: note("<[b4 ~ a4 g4] [~ e4 ~ g4] [a4 b4 ~ d5] [~ ~ b4 ~]>")
  .s("sawtooth")
  .lpf(sine.range(900, 4000).slow(8))
  .lpq(3)
  .gain(.5)
  .decay(.12).sustain(.08).release(.06)
  .room(.18).roomsize(1.5)
  .orbit(1)
  ._pianoroll({color:"#ff00ff"})

// === ACID BASS — Squelchy support underneath ===
$: note("<[e2 ~ e2 ~] [~ e2 ~ g2] [a2 ~ a1 ~] [~ b1 ~ e2]>")
  .s("sawtooth")
  .acidenv(0.45)
  .lpq(10)
  .gain(.88)
  .distort(2)
  .orbit(4)

// === ACID BASS ALT — More active, higher squelch ===
_$: note("<[e2 g2 e2 a2] [~ e2 b1 ~] [a1 ~ g2 a2] [b1 e2 ~ e2]>")
  .s("sawtooth")
  .acidenv(0.65)
  .lpq(12)
  .gain(.45)
  .distort(.6)
  .orbit(4)

// === CHORD STABS — FM piano, disco upbeats ===
$: note("<[~ [e3,g3,b3,d4] ~ [e3,g3,b3,d4]] [~ [a3,c4,e4,g4] ~ ~] [~ [b3,d4,f#4,a4] ~ [b3,d4,f#4,a4]] [~ ~ [a3,c4,e4,g4] ~]>")
  .s("sine")
  .fm(3).fmh(2.01)
  .decay(.1).sustain(0).release(.06)
  .gain(.32)
  .delay(.2).delaytime(3/16).delayfeedback(.3)
  .room(.2).roomsize(1.5)
  .swingBy(1/8, 4)
  .orbit(5)

// === CHORD STABS ALT — Tighter rhythm, root position ===
_$: note("<[~ [e3,g3,b3] ~ ~] [~ [a3,c4,e4] ~ [a3,c4,e4]] [~ ~ [b3,d4,f#4] ~] [[e3,g3,b3] ~ ~ [e3,g3,b3]]>")
  .s("sine")
  .fm(3).fmh(2.01)
  .decay(.08).sustain(0).release(.05)
  .gain(.3)
  .delay(.15).delaytime(3/16).delayfeedback(.25)
  .room(.2).roomsize(1.5)
  .swingBy(1/8, 4)
  .orbit(5)

// === SUB BASS — Low-end foundation ===
$: note("e1")
  .s("sine")
  .lpf(55)
  .gain(.4)
  .decay(.5).sustain(.3).release(.2)
  .orbit(6)
