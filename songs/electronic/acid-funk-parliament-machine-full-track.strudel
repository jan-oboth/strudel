// PARLIAMENT MACHINE — acid funk full track
// Electro-funk maximalist, LinnDrum, Parliament-Funkadelic meets synth funk
// Phases: Intro(8) → Build(8) → Groove(16) → Develop(16) → Peak(24) → Break(8) → Return(16) → Outro(8)
// Total: 104 cycles (~3:31 at 118 BPM)
setCps(118/60/4)

// === KICK — four-on-floor LinnDrum, sidechain master ===
$: arrange(
  [8, s("~")],
  [8, s("bd*4")],
  [16, s("bd*4")],
  [16, s("bd*4")],
  [24, s("bd*4")],
  [8, s("~")],
  [16, s("bd*4")],
  [8, s("bd [~ bd] [bd ~] [~ bd:1]")]
).bank("linn")
  .gain(.88).shape(.2).lpf(2800)
  .room(.05).roomsize(1)
  .duck("1:2:3:4:5:6:7").duckattack(.015).duckdepth(.85)
  .orbit(0)
  ._scope({color:"#ffcc00", thickness:2})
  ._spectrum({color:"#ffcc00", thickness:2})

// === SNARE — backbeat to ghost notes ===
$: arrange(
  [8, s("~")],
  [8, s("~")],
  [16, s("~ sd ~ sd")],
  [16, s("~ sd [~ sd:1] sd, [~ ~ ~ sd:1]*2")],
  [24, s("~ sd [~ sd:1] sd, [~ ~ ~ sd:1]*2")],
  [8, s("~")],
  [16, s("~ sd [~ sd:1] sd, [~ ~ ~ sd:1]*2")],
  [8, s("~ sd ~ sd")]
).bank("linn")
  .gain("<0.35 0.18 0.28 0.18>*4")
  .room(.2).roomsize(1.5).hpf(800)
  .orbit(2)

// === HATS — 8ths to 16ths ===
$: arrange(
  [8, s("~")],
  [8, s("hh*8")],
  [16, s("hh*8")],
  [16, s("hh*8")],
  [24, s("hh*16")],
  [8, s("~")],
  [16, s("hh*16")],
  [8, s("hh*8")]
).bank("linn")
  .gain("<0.2 0.08 0.15 0.08>*4")
  .hpf(6000).pan(rand.range(.3,.7))
  .swingBy(1/8, 4)
  .orbit(3)

// === RIM — rotating funk percussion ===
$: arrange(
  [8, s("~")],
  [8, s("<[~ rim ~ ~] [~ ~ rim ~] [~ ~ ~ rim] [rim ~ ~ ~]>")],
  [16, s("<[~ rim ~ ~] [~ ~ rim ~] [~ ~ ~ rim] [rim ~ ~ ~]>")],
  [16, s("<[~ rim ~ ~] [~ ~ rim ~] [~ ~ ~ rim] [rim ~ ~ ~]>")],
  [24, s("<[~ rim ~ ~] [~ ~ rim ~] [~ ~ ~ rim] [rim ~ ~ ~]>")],
  [8, s("~")],
  [16, s("<[~ rim ~ ~] [~ ~ rim ~] [~ ~ ~ rim] [rim ~ ~ ~]>")],
  [8, s("~")]
).bank("linn")
  .gain(.22).hpf(2000)
  .orbit(3)

// === OPEN HAT — offbeat breath ===
$: arrange(
  [8, s("~")],
  [8, s("~")],
  [16, s("~")],
  [16, s("~ oh ~ oh")],
  [24, s("~ oh ~ oh")],
  [8, s("~")],
  [16, s("~ oh ~ oh")],
  [8, s("~")]
).bank("linn")
  .gain(.2).hpf(5500).decay(.1)
  .orbit(3)

// === FUNK BASS — the groove anchor ===
$: arrange(
  [8, s("~")],
  [8, s("~")],
  [16, note("<[e2 ~ ~ ~] [~ g2 ~ ~] [b2 ~ ~ a2] [~ ~ e2 ~]>")],
  [16, note("<[e2 e3 e2 e3] [g2 g3 a2 a3] [b2 b3 e2 e3] [e2 e3 d#2 e2]>")],
  [24, note("<[e2 e3 e2 e3] [g2 g3 a2 a3] [b2 b3 e2 e3] [e2 e3 d#2 e2]>")],
  [8, note("<[e2 ~ ~ ~] [~ g2 ~ ~] [b2 ~ ~ a2] [~ ~ e2 ~]>")],
  [16, note("<[e2 ~ e3 e2] [~ g2 a2 ~] [b2 ~ e2 d#2] [e2 ~ ~ e3]>")],
  [8, note("<[e2 ~ ~ ~] [~ g2 ~ ~] [b2 ~ ~ a2] [~ ~ e2 ~]>")]
).s("sawtooth")
  .lpf(500).lpq(5)
  .shape(.2)
  .decay(.12).sustain(.08).release(.05)
  .gain(.75)
  .swingBy(1/8, 4)
  .orbit(1)
  ._pianoroll({color:"#ffcc00"})

// === CLAVINET — funky keyboard stabs (replaces acid) ===
$: arrange(
  [8, s("~")],
  [8, s("~")],
  [16, s("~")],
  [16, note("<[~ ~ e4 ~] [g4 ~ ~ ~] [~ a4 ~ b4] [~ ~ ~ e4]>")],
  [24, note("<[e4 ~ e4 ~] [~ g4 ~ g4] [a4 ~ b4 ~] [~ e4 ~ ~]>")],
  [8, s("~")],
  [16, note("<[~ ~ e4 ~] [g4 ~ ~ ~] [~ a4 ~ b4] [~ ~ ~ e4]>")],
  [8, s("~")]
).s("sawtooth")
  .hpf(500).lpf(4000)
  .decay(.04).sustain(0).release(.02)
  .gain(.4)
  .shape(.15)
  .swingBy(1/8, 4)
  .orbit(4)

// === LEAD — response phrase ===
$: arrange(
  [8, s("~")],
  [8, s("~")],
  [16, s("~")],
  [16, note("<[e4 ~ ~ ~] [~ ~ b3 ~] [a3 ~ ~ d4] [~ b3 ~ ~]>")],
  [24, note("<[e4 ~ ~ ~] [~ ~ b3 ~] [a3 ~ ~ d4] [~ b3 ~ ~]>")],
  [8, s("~")],
  [16, note("<[~ ~ g4 ~] [b3 ~ ~ e4] [~ d4 ~ ~] [a3 ~ b3 ~]>")],
  [8, s("~")]
).s("square")
  .lpf(2000).lpq(3)
  .decay(.1).sustain(.05).release(.06)
  .gain(.8)
  .room(.2).roomsize(1.5)
  .delay(.15).delaytime(1/8).delayfeedback(.25)
  .orbit(5)

// === CHORD WAH — Parliament keyboard wash ===
$: arrange(
  [8, note("<[~ [e3,g3,b3,d4,f#4] ~ ~] [~ ~ [a3,c4,e4,g4] ~]>")],
  [8, note("<[~ [e3,g3,b3,d4,f#4] ~ ~] [~ ~ [a3,c4,e4,g4] ~]>")],
  [16, note("<[~ [e3,g3,b3,d4,f#4] ~ ~] [~ ~ [a3,c4,e4,g4] ~]>")],
  [16, note("<[~ [e3,g3,b3,d4,f#4] ~ ~] [~ ~ [a3,c4,e4,g4] ~]>")],
  [24, note("<[[e3,g3,b3,d4,f#4] ~ [e3,g3,b3,d4,f#4] ~] [[a3,c4,e4,g4] ~ ~ [a3,c4,e4,g4]]>")],
  [8, note("<[~ [e3,g3,b3,d4,f#4] ~ ~] [~ ~ [a3,c4,e4,g4] ~]>")],
  [16, note("<[[e3,g3,b3,d4,f#4] ~ [e3,g3,b3,d4,f#4] ~] [[a3,c4,e4,g4] ~ ~ [a3,c4,e4,g4]]>")],
  [8, note("<[~ [e3,g3,b3,d4,f#4] ~ ~] [~ ~ [a3,c4,e4,g4] ~]>")]
).s("sawtooth").superimpose(x => x.add(0.08))
  .lpf(sine.range(400, 3000).slow(4)).lpq(6)
  .decay(.2).sustain(.1).release(.1)
  .gain(.55)
  .pan(sine.range(.35,.65).slow(3))
  .orbit(6)

// === SUB BASS — root anchor, always present ===
$: note("e1")
  .s("sine")
  .lpf(60).gain(.42)
  .decay(.5).sustain(.3).release(.2)
  .orbit(7)
